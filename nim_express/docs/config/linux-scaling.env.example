# Linux throughput profile
NIM_EXPRESS_PROFILE=linux-throughput

# Choose one: auto | cluster | threaded
NIM_EXPRESS_SCALE_MODE=cluster

# 0 means runtime default sizing (~40% of online CPUs).
NIM_EXPRESS_WORKERS=8
NIM_EXPRESS_THREADS=0

# Port and host topology for launcher scripts.
NIM_EXPRESS_BASE_PORT=3002
NIM_EXPRESS_CPU_LIST=0-7
NIM_EXPRESS_NUMA_NODE=0
