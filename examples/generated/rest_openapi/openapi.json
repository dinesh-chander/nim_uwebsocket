{
  "openapi": "3.1.0",
  "info": {
    "title": "nim_express REST OpenAPI example",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/api/todos": {
      "get": {
        "summary": "List todos"
      },
      "post": {
